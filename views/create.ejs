<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="mx-auto p-3 bg-zinc-600 w-full h-screen text-zinc-300">
        <form action="/edit" method="post" >
            <input  type="text" name="previous" placeholder="previous name" class="p-3 pt-4 rounded-lg bg-white block w-2/4" value="<%= pathname %>">
            <input  type="text" name="new" placeholder="Enter New Name" class="p-3 rounded-lg bg-white block w-2/4 pt-4 my-4 text-zinc-400" >
            <input type="submit" class="py-4 px-12 border bg-blue-300 text-center font-bold rounded text-white">
        </form> 
      
    </div>
</body>
</html>